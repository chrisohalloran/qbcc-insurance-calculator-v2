# Resend email integration (optional)
RESEND_API_KEY=re_your_key_here
LEAD_NOTIFICATION_EMAIL=chris@strikinggroup.com.au
LEAD_EMAIL_FROM=QBCC Calculator <quotes@mail.levasolutions.com.au>
LEAD_EMAIL_REPLY_TO=chris@strikinggroup.com.au
# Backward-compatible alias for LEAD_NOTIFICATION_EMAIL.
NOTIFICATION_EMAIL=chris@strikinggroup.com.au

# Analytics: use GTM or direct GA4, not both. GTM takes precedence.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX
NEXT_PUBLIC_POSTHOG_KEY=phc_your_project_key
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Postgres (Vercel Postgres / Neon). Stores calculator runs and leads,
# including abandoned forms. Either variable works. Set this in Vercel.
# The hostname is a placeholder here, so the Neon region is not recorded in this repo.
DATABASE_URL=postgres://USER:PASSWORD@HOST/DB?sslmode=require
# Vercel Cron calls GET /api/cron/retention with Authorization: Bearer $CRON_SECRET.
# The route rejects every request when this is unset. Set it in the host's env, not here.
CRON_SECRET=
# POSTGRES_URL is also accepted (Vercel Postgres default name).
# POSTGRES_URL=

# Lead capture persistence
# In production, configure DATABASE_URL and/or Resend email variables above,
# or set LEADS_WEBHOOK_URL to a durable destination such as Zapier, Make,
# HubSpot, Airtable, a private API, or another webhook receiver.
LEADS_WEBHOOK_URL=https://example.com/qbcc-leads
LEADS_WEBHOOK_SECRET=change-me

# Development only. Local JSON storage is not durable on Vercel production.
LEADS_STORAGE_MODE=local
# Optional only when LEADS_STORAGE_MODE=local. Useful for isolated local tests.
LEADS_DATA_DIR=/tmp/qbcc-calculator-local-data
# Tendrank signed draft receiver. Must match the shared secret already
# configured on the Tendrank site. Do not commit the live value.
TENDRANK_PUBLISH_SECRET=
